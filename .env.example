# ==============================================================================
# Riverè Cafe & Bakery - Environment Variables Configuration
# File: .env.example
# Description: Template for environment keys required by Supabase & database layer
# ==============================================================================

# Public Supabase API Endpoint (Exposed to Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase Anon (Publishable) Key (Exposed to Browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_token_here

# Secret Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_token_here
